# Entity: article

main: kit: entity: article: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "imageUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "publishedAt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "article"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/articles/home"
          parts: [
            "articles"
            "home"
          ]
          select: {
            "$action": "home"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.articles`"
          }
        }
      ]
    }
  }



}
