# Entity: article

main: kit: entity: article: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      short: "Article author name"
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      short: "Article category (e.g., politics, economy, culture, sports)"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Brief summary of the article"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the article"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "imageUrl"
      req: false
      short: "URL to the article's main image"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "publishedAt"
      req: false
      short: "Publication timestamp"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Article headline"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "URL to the full article"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "article"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/articles/home"
          segments: [
            {
              lit: "articles"
            }
            {
              lit: "home"
            }
          ]
          select: {
            "$action": "home"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.articles`"
          }
        }
      ]
    }
  }



}
